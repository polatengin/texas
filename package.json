{
  "name": "@polatengin/texas",
  "version": "0.0.4",
  "description": "AVM MCP server using Model Context Protocol TypeScript SDK",
  "main": "dist/index.js",
  "bin": {
    "texas": "dist/index.js"
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/polatengin/texas.git"
  },
  "homepage": "https://github.com/polatengin/texas#readme",
  "bugs": {
    "url": "https://github.com/polatengin/texas/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "avm",
    "azure",
    "bicep"
  ],
  "author": "polatengin",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && npx tsc && chmod +x ./dist/index.js",
    "start": "npx tsx index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.25.2",
    "marked": "16.2.0",
    "node-fetch": "3.3.2"
  },
  "devDependencies": {
    "@types/marked": "6.0.0",
    "@types/node": "24.3.0",
    "ts-node": "10.9.2",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
